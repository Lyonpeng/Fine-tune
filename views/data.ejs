<style>
    .data-page {
        max-width: 1200px;
    }

    .data-section {
        background: rgba(17, 24, 39, 0.55);
        border: 1px solid rgba(31, 41, 55, 0.7);
        border-radius: 12px;
        padding: 25px;
        margin-bottom: 25px;
    }

    .section-header {
        margin-bottom: 25px;
    }

    .section-header h2 {
        font-size: 20px;
        color: #e5e7eb;
        margin-bottom: 6px;
    }

    .section-header p {
        color: #9ca3af;
        font-size: 14px;
    }

    .upload-layout {
        display: flex;
        flex-direction: column;
        gap: 25px;
    }

    .dataset-name-section h3,
    .image-upload-section h3 {
        color: #e5e7eb;
        font-size: .8rem;
        font-weight: 600;
        letter-spacing: .05em;
        margin-bottom: 6px;
    }

    .dataset-name-input {
        width: 100%;
        padding: 10px;
        border: 1px solid #374151;
        border-radius: 6px;
        font-size: 14px;
        font-family: inherit;
        background: rgba(3, 7, 18, 0.5);
        color: #e5e7eb;
    }

    .dataset-name-input::placeholder {
        color: #6b7280;
    }

    .dataset-name-input:focus {
        outline: none;
        border-color: #14b8a6;
    }

    .dataset-name-input.invalid {
        border-color: rgba(248, 113, 113, 0.6);
    }

    .field-error {
        display: none;
        margin-top: 6px;
        color: #f87171;
        font-size: 13px;
    }

    .field-error:not(:empty) {
        display: block;
    }

    /* upload result message (same as Acacia's #upload-message) */
    .upload-message {
        display: none;
        margin-top: 12px;
        padding: 10px;
        border-radius: 6px;
        font-size: 14px;
    }

    .upload-message.error {
        display: block;
        color: #fca5a5;
        background: rgba(127, 29, 29, 0.25);
        border: 1px solid rgba(248, 113, 113, 0.4);
    }

    .upload-message.success {
        display: block;
        color: #4ade80;
        background: rgba(22, 101, 52, 0.2);
        border: 1px solid rgba(74, 222, 128, 0.4);
    }

    .upload-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .image-upload-section > p {
        color: #9ca3af;
        font-size: 13px;
        margin-bottom: 15px;
    }

    .upload-box {
        border: 2px dashed rgba(20, 184, 166, 0.35);
        border-radius: 10px;
        padding: 25px;
        background: rgba(3, 7, 18, 0.4);
    }

    .upload-box:hover {
        border-color: rgba(20, 184, 166, 0.6);
    }

    .upload-box input[type="file"] {
        display: none;
    }

    .image-upload-label {
        min-height: 130px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        border-radius: 6px;
        cursor: pointer;
    }

    .image-upload-label:hover {
        background-color: rgba(20, 184, 166, 0.05);
    }

    .upload-icon {
        font-size: 32px;
        color: #14b8a6;
        margin-bottom: 10px;
    }

    .image-upload-label strong {
        color: #e5e7eb;
        margin-bottom: 6px;
    }

    .image-upload-label span {
        color: #6b7280;
        font-size: 12px;
    }

    .image-preview-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
        gap: 15px;
        margin-top: 20px;
    }

    .preview-item {
        background-color: #111827;
        border: 1px solid rgba(31, 41, 55, 0.9);
        border-radius: 6px;
        overflow: hidden;
    }

    .preview-item img {
        display: block;
        width: 100%;
        height: 100px;
        object-fit: cover;
    }

    .preview-name {
        padding: 8px;
        color: #9ca3af;
        font-size: 11px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .annotation-section {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 18px;
        border: 1px solid rgba(31, 41, 55, 0.6);
        border-radius: 10px;
        background: rgba(3, 7, 18, 0.35);
    }
    .annotation-file-control {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
    .annotation-info {
        flex: 1;
    }

    .annotation-info h3 {
        color: #e5e7eb;
        margin-bottom: 5px;
        font-size: .8rem;
        letter-spacing: .05em;
    }

    .annotation-info p {
        color: #9ca3af;
        font-size: 13px;
    }

    .annotation-section input[type="file"] {
        display: none;
    }

    .file-button {
        padding: 9px 15px;
        background-color: #111827;
        border: 1px solid #374151;
        border-radius: 6px;
        color: #d1d5db;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
        transition: all .15s;
    }

    .file-button:hover {
        border-color: rgba(20, 184, 166, 0.45);
        color: #5eead4;
    }

    .annotation-file-name {
        color: #9ca3af;
        font-size: 12px;
        max-width: 200px;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    .upload-actions {
        display: flex;
        justify-content: flex-end;
        margin-top: 25px;
    }

    .upload-btn {
        padding: 10px 24px;
        border: none;
        border-radius: 6px;
        background: linear-gradient(to top, #0d9488, #14b8a6);
        color: #fff;
        font-size: 14px;
        font-weight: 600;
        font-family: inherit;
        cursor: pointer;
    }

    .upload-btn:hover {
        background: linear-gradient(to top, #0f766e, #0d9488);
    }

    .dataset-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
    }

    .dataset-count {
        padding: 4px 12px;
        border: 1px solid rgba(20, 184, 166, 0.35);
        background-color: rgba(20, 184, 166, 0.08);
        border-radius: 20px;
        color: #5eead4;
        font-size: 13px;
        font-weight: 600;
    }

    .table-container {
        overflow-x: auto;
    }

    .dataset-table {
        width: 100%;
        border-collapse: collapse;
    }

    .dataset-table th,
    .dataset-table td {
        padding: 12px 15px;
        text-align: left;
        vertical-align: middle;
        border-bottom: 1px solid rgba(31, 41, 55, 0.5);
        font-size: 14px;
    }

    .dataset-table th {
        font-size: .72rem;
        text-transform: uppercase;
        letter-spacing: .05em;
        color: #9ca3af;
        border-bottom-color: #1f2937;
        font-weight: 600;
    }

    .dataset-table td {
        color: #d1d5db;
    }

    .dataset-table td strong {
        color: #e5e7eb;
    }

    .dataset-image-preview {
        width: 60px;
        height: 45px;
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: #1f2937;
        border-radius: 5px;
        color: #9ca3af;
        font-size: 10px;
    }

    .file-info {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .file-info strong {
        color: #e5e7eb;
        font-size: 13px;
    }

    .file-info span {
        color: #6b7280;
        font-size: 11px;
    }

    .status {
        display: inline-block;
        padding: 4px 10px;
        border: 1px solid transparent;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .status.ready {
        background-color: rgba(22, 101, 52, 0.2);
        border-color: rgba(74, 222, 128, 0.4);
        color: #4ade80;
    }

    .status.incomplete {
        background-color: rgba(120, 53, 15, 0.25);
        border-color: rgba(251, 191, 36, 0.4);
        color: #fbbf24;
    }

    .action-btn {
        padding: 4px 12px;
        border: 1px solid #374151;
        border-radius: 6px;
        background-color: #111827;
        color: #d1d5db;
        font-size: 13px;
        font-family: inherit;
        cursor: pointer;
    }

    .action-btn:hover {
        border-color: rgba(20, 184, 166, 0.45);
        color: #5eead4;
    }

    .action-btn.delete {
        color: #f87171;
        margin-left: 5px;
    }

    .action-btn.delete:hover {
        background-color: rgba(248, 113, 113, 0.12);
        border-color: rgba(248, 113, 113, 0.45);
        color: #f87171;
    }

    @media (max-width: 800px) {
        .annotation-section {
            align-items: flex-start;
            flex-direction: column;
        }

        .annotation-file-name {
            max-width: 100%;
        }
    }
</style>
<div class="data-page">
  <!-- Upload Data -->
  <section class="data-section">
    <div class="section-header">
      <h2>Upload Data</h2>
    </div>

    <form action="/upload" method="POST" enctype="multipart/form-data" novalidate onsubmit="submitDataset(event)">
      <div class="upload-layout">

        <!-- Dataset Name -->
        <div class="dataset-name-section">
          <h3>Dataset Name</h3>
          <input
            type="text"
            id="folderName"
            name="folderName"
            class="dataset-name-input"
            placeholder="e.g. Acacia Dataset"
            maxlength="64"
            autocomplete="off"
            oninput="validateDatasetName()"
            required
          >
          <span id="folderNameError" class="field-error"></span>
        </div>

        <!-- Images -->
        <div class="image-upload-section">
          <h3>Images</h3>

          <div class="upload-box">
            <input type="file" id="images" name="images" accept=".jpg,.jpeg,.png" multiple required onchange="previewImages(event)">
            <label for="images" id="imageUploadLabel" class="image-upload-label">
                <div class="upload-icon">▧</div>
                <strong>Select Images</strong>
                <span>JPG, JPEG or PNG</span>
            </label>

            <div id="imagePreviewContainer" class="image-preview-grid"></div>
            </div>
        </div>
        <!-- Annotation -->
        <div class="annotation-section">
          <div class="annotation-info">
            <h3>Annotation File</h3>
          </div>
          <div class="annotation-file-control">
            <input type="file" id="associatedData" name="associatedData" accept=".json" onchange="showAnnotationFile(event)">
            <label for="associatedData" class="file-button">Select File</label>
            <span id="annotationFileName" class="annotation-file-name"></span>
          </div>
        </div>
      </div>

      <div class="upload-actions">
        <button type="submit" id="uploadDataBtn" class="upload-btn">Upload Data</button>
      </div>
      <div id="uploadMessage" class="upload-message"></div>
    </form>
  </section>

  <!-- Dataset -->
  <section class="data-section">
    <div class="dataset-header">
      <div class="section-header">
        <h2>Dataset</h2>
      </div>
      <div class="dataset-count" id="datasetCount">0 Datasets</div>
    </div>

    <div class="table-container">
      <table class="dataset-table">
        <thead>
          <tr>
            <th>Dataset</th>
            <th>Images</th>
            <th>Annotation</th>
            <th>Created</th>
            <th>Size</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody id="datasetTable"></tbody>
      </table>
    </div>
  </section>
</div>

<script>

document.getElementById("uploadForm").addEventListener("submit", async function(event) {
  event.preventDefault();

  const imageInput = document.getElementById("images");

  if (imageInput.files.length === 0) {
    alert("Please select at least one image.");
    return;
  }

  const formData = new FormData();

  for (const file of imageInput.files) {
    formData.append("images", file);
  }

  try {
    const response = await fetch("/upload", {
      method: "POST",
      body: formData
    });

    const result = await response.json();

    if (!response.ok) {
      throw new Error(result.message || "Upload failed");
    }

    alert("Images uploaded successfully!");
    document.getElementById("uploadForm").reset();
    document.getElementById("annotationFileName").textContent = "No file selected";
  } catch (error) {
    console.error(error);
    alert(error.message);
  }
});
</script>
