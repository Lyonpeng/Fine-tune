<div class="model-page">
    <section class="model-section">
        <div class="model-section-header">
            <h2>Available Models</h2>
        </div>
        <div class="model-table-container">
            <table class="model-table">
                <thead>
                    <tr>
                        <th scope="col">Training Run</th>
                        <th scope="col">Model Used</th>
                        <th scope="col">Dataset Trained On</th>
                        <th scope="col">Date Completed</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (models.length === 0) { %>
                        <tr><td colspan="5">No trained models available.</td></tr>
                    <% } %>
                    <% models.forEach(model => { const base = '/api/training/' + encodeURIComponent(model.name); %>
                        <tr>
                            <td class="model-run-name"><%= model.name %></td>
                            <td><%= model.model %></td>
                            <td><%= model.dataset %></td>
                            <td>
                                <% if (model.completedAt) { %>
                                    <time datetime="<%= new Date(model.completedAt).toISOString() %>"><%= new Date(model.completedAt).toLocaleString('en-GB', { timeZone: 'Asia/Brunei', dateStyle: 'medium', timeStyle: 'short' }) %> (BNT)</time>
                                <% } else { %>
                                    Not completed
                                <% } %>
                            </td>
                            <td>
                                <div class="model-actions">
                                    <a class="model-action model-download" href="<%= base %>/models/<%= encodeURIComponent(model.filename) %>" download>Download Model</a>
                                    <% if (model.hasLoss) { %>
                                        <a class="model-action" href="<%= base %>/loss" target="_blank" rel="noopener">Train Loss</a>
                                    <% } else { %>
                                        <span class="model-action unavailable" title="Training loss plot is not available">Train Loss unavailable</span>
                                    <% } %>
                                    <% if (model.hasConfig) { %>
                                        <a class="model-action" href="<%= base %>/config" target="_blank" rel="noopener">Config</a>
                                    <% } else { %>
                                        <span class="model-action unavailable" title="Configuration is not available">Config unavailable</span>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </section>
</div>
<style>
    .model-page { max-width: 1200px; }
    .model-section-header p { color: #9ca3af; }
    .model-section { background: rgba(17, 24, 39, 0.55); border: 1px solid rgba(31, 41, 55, 0.7); border-radius: 12px; padding: 25px; }
    .model-section-header { margin-bottom: 25px; }
    .model-section-header h2 { font-size: 20px; color: #e5e7eb; margin-bottom: 6px; }
    .model-section-header p { font-size: 14px; }
    .model-table-container { overflow-x: auto; }
    .model-table { width: 100%; border-collapse: collapse; }
    .model-table th, .model-table td { padding: 12px 15px; text-align: left; border-bottom: 1px solid rgba(31, 41, 55, 0.5); font-size: 14px; }
    .model-table th { font-size: .72rem; text-transform: uppercase; letter-spacing: .05em; color: #9ca3af; border-bottom-color: #1f2937; font-weight: 600; white-space: nowrap; }
    .model-table td { color: #d1d5db; vertical-align: top; }
    .model-run-name { min-width: 180px; overflow-wrap: anywhere; color: #e5e7eb; }
    .model-actions { display: flex; flex-wrap: wrap; gap: 8px; min-width: 220px; }
    .model-action { display: inline-block; padding: 6px 12px; border: 1px solid #374151; border-radius: 6px; background: #111827; color: #d1d5db; font-size: 13px; text-decoration: none; white-space: nowrap; transition: all .15s; }
    a.model-action:hover { border-color: rgba(20, 184, 166, 0.45); color: #5eead4; }
    .model-download { background: linear-gradient(to top, #0d9488, #14b8a6); border-color: transparent; color: #fff; font-weight: 600; }
    a.model-download:hover { background: linear-gradient(to top, #0f766e, #0d9488); border-color: transparent; color: #fff; }
    .model-action:focus-visible { outline: 2px solid #14b8a6; outline-offset: 2px; }
    .model-action.unavailable { color: #6b7280; background: transparent; border-color: #1f2937; }
    @media (max-width: 600px) { .model-section { padding: 15px; } }
</style>
