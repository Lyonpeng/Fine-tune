<div class="model-page">
    <section class="model-section">
        <div class="model-section-header">
            <h2>Available Models</h2>
        </div>
        <div class="model-table-container">
            <table class="model-table">
                <thead>
                    <tr>
                        <th scope="col">Training Run</th>
                        <th scope="col">Model Used</th>
                        <th scope="col">Dataset Trained On</th>
                        <th scope="col">Date Completed</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (models.length === 0) { %>
                        <tr><td colspan="5">No trained models available.</td></tr>
                    <% } %>
                    <% models.forEach(model => { const base = '/api/training/' + encodeURIComponent(model.name); %>
                        <tr>
                            <td class="model-run-name"><%= model.name %></td>
                            <td><%= model.model %></td>
                            <td><%= model.dataset %></td>
                            <td>
                                <% if (model.completedAt) { %>
                                    <time datetime="<%= new Date(model.completedAt).toISOString() %>"><%= new Date(model.completedAt).toLocaleString('en-GB', { timeZone: 'Asia/Brunei', dateStyle: 'medium', timeStyle: 'short' }) %> (BNT)</time>
                                <% } else { %>
                                    Not completed
                                <% } %>
                            </td>
                            <td>
                                <div class="model-actions">
                                    <a class="model-action model-download" href="<%= base %>/models/<%= encodeURIComponent(model.filename) %>" download>Download Model</a>
                                    <% if (model.hasLoss) { %>
                                        <a class="model-action" href="<%= base %>/loss" target="_blank" rel="noopener">Train Loss</a>
                                    <% } else { %>
                                        <span class="model-action unavailable" title="Training loss plot is not available">Train Loss unavailable</span>
                                    <% } %>
                                    <% if (model.hasConfig) { %>
                                        <a class="model-action" href="<%= base %>/config" target="_blank" rel="noopener">Config</a>
                                    <% } else { %>
                                        <span class="model-action unavailable" title="Configuration is not available">Config unavailable</span>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </section>
</div>
<style>
    .model-page { max-width: 1200px; }
    .model-section-header p { color: #6b7280; }
    .model-section { background: white; border: 1px solid #e5e7eb; border-radius: 8px; padding: 25px; }
    .model-section-header { margin-bottom: 25px; }
    .model-section-header h2 { font-size: 20px; color: #111827; margin-bottom: 6px; }
    .model-section-header p { font-size: 14px; }
    .model-table-container { overflow-x: auto; }
    .model-table { width: 100%; border-collapse: collapse; }
    .model-table th, .model-table td { padding: 12px 15px; text-align: left; border-bottom: 1px solid #e5e7eb; font-size: 14px; }
    .model-table th { color: #374151; background: #f9fafb; font-weight: 600; }
    .model-table td { color: #4b5563; vertical-align: top; }
    .model-run-name { min-width: 180px; overflow-wrap: anywhere; }
    .model-actions { display: flex; flex-wrap: wrap; gap: 8px; min-width: 220px; }
    .model-action { display: inline-block; padding: 8px 12px; border: 1px solid #d1d5db; border-radius: 5px; color: #374151; text-decoration: none; white-space: nowrap; }
    a.model-action:hover { background: #f3f4f6; }
    .model-download { background: #1f2937; border-color: #1f2937; color: white; }
    a.model-download:hover { background: #374151; }
    .model-action:focus-visible { outline: 2px solid #2563eb; outline-offset: 2px; }
    .model-action.unavailable { color: #9ca3af; background: #f9fafb; }
    @media (max-width: 600px) { .model-section { padding: 15px; } }
</style>
