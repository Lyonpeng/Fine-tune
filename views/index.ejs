<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Detectron2</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        /* IADA dashboard theme (dark gray-950 + teal), matching AcaciaGeolocation */
        :root {
            color-scheme: dark;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', 'Segoe UI', system-ui, Arial, sans-serif;
            background-color: #030712;
            color: #e5e7eb;
        }

        /* faint teal wash at the top */
        body::before {
            content: "";
            position: fixed;
            inset: 0;
            z-index: -1;
            pointer-events: none;
            background: radial-gradient(120% 90% at 50% -10%, rgba(20, 184, 166, 0.08), rgba(3, 7, 18, 0) 55%);
        }

        a {
            color: #5eead4;
        }

        /* Top bar (56px IADA bar, as in AcaciaGeolocation) */
        #hdr {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 100;

            height: 56px;
            display: flex;
            align-items: center;
            padding: 0 16px;

            background: rgba(3, 7, 18, 0.85);
            border-bottom: 1px solid rgba(31, 41, 55, 0.7);
            backdrop-filter: blur(12px);
        }

        #hdr a {
            display: flex;
            align-items: center;
        }

        #hdr img {
            height: 28px;
            width: auto;
        }

        /* Sidebar */
        .sidebar {
            position: fixed;
            top: 56px;
            left: 0;

            width: 220px;
            height: calc(100vh - 56px);

            background: rgba(3, 7, 18, 0.85);
            border-right: 1px solid rgba(31, 41, 55, 0.7);
            backdrop-filter: blur(12px);
            padding-top: 24px;
        }

        .sidebar h2 {
            color: #e5e7eb;
            font-size: 1.1rem;
            font-weight: 600;
            padding: 0 24px;
            margin-bottom: 24px;
        }

        .sidebar a {
            display: block;

            padding: 12px 24px;

            color: #9ca3af;
            text-decoration: none;
            font-size: 15px;
            border-left: 2px solid transparent;
            transition: all .15s;
        }

        .sidebar a:hover {
            background-color: rgba(31, 41, 55, 0.5);
            color: #5eead4;
        }

        /* Current page */
        .sidebar a.active {
            background-color: rgba(20, 184, 166, 0.08);
            border-left-color: #14b8a6;
            color: #5eead4;
            font-weight: 600;
        }

        /* Main content */
        .main-content {
            margin-left: 220px;
            padding: 96px 40px 40px;   /* 56px top bar + 40px */
        }

        .main-content h1 {
            margin-bottom: 10px;
            color: #e5e7eb;
        }

        .main-content p {
            color: #9ca3af;
        }

        /* Annotate page: kept in its own container so the VIA iframe (and any
           unsaved annotations in it) survives switching to other pages */
        #annotateHost {
            margin-left: 220px;
            height: 100vh;
            padding: 80px 24px 24px;   /* 56px top bar + 24px */
        }

        #annotateHost[hidden],
        .main-content[hidden] {
            display: none;
        }
    </style>
</head>

<body>

    <!-- Top bar -->
    <div id="hdr">
        <a href="http://10.1.7.26:8083/">
            <img src="/iada-logo-onbg.png" alt="IADA">
        </a>
    </div>

    <!-- Sidebar -->
    <div class="sidebar">
        <a href="#" class="active" data-page="annotate" onclick="loadPage('annotate'); return false;">Annotate</a>
        <a href="#" data-page="data" onclick="loadPage('data'); return false;">Data</a>
        <a href="#" data-page="train" onclick="loadPage('train'); return false;">Train</a>
        <a href="#" data-page="validation" onclick="loadPage('validation'); return false;">Validation</a>
    </div>
    <!-- Main page -->
    <main class="main-content" hidden></main>
    <div id="annotateHost"></div>
    <script>

        async function loadPage(page) {
            // highlight the sidebar link of the page being shown
            document.querySelectorAll(".sidebar a").forEach(link => {
                link.classList.toggle("active", link.dataset.page === page);
            });

            const main = document.querySelector(".main-content");
            const annotateHost = document.getElementById("annotateHost");

            // The Annotate page is loaded once and then only hidden/shown, since
            // replacing it would reload VIA and discard its annotations
            if (page === "annotate") {
                if (!annotateHost.hasChildNodes()) {
                    const response = await fetch("/pages/annotate");
                    annotateHost.innerHTML = await response.text();
                }
                main.hidden = true;
                annotateHost.hidden = false;
                return;
            }
            annotateHost.hidden = true;
            main.hidden = false;

            const response = await fetch(`/pages/${page}`);
            const html = await response.text();

            main.innerHTML = html;

            if (page === "data") {
                loadDatasets();
            }

            if (page === "train") {
                loadTrainingDatasets();
                loadTrainingHistory();
            }

            if (page === "validation") {
                selectedValidationId = null;
                loadValidationDatasets();
                loadValidationHistory();
            }
        }
        setInterval(() => {
            if (document.getElementById("runtimeHistory")) {
                loadTrainingHistory();
            }
        }, 1000);
        function previewImages(event) {
            const files = event.target.files;
            const container = document.getElementById("imagePreviewContainer");
            const uploadLabel = document.getElementById("imageUploadLabel");

            container.innerHTML = "";

            if (files.length === 0) {
                uploadLabel.style.display = "flex";
                return;
            }

            uploadLabel.style.display = "none";

            for (const file of files) {
                const previewItem = document.createElement("div");
                previewItem.className = "preview-item";

                const img = document.createElement("img");
                img.src = URL.createObjectURL(file);

                const fileName = document.createElement("div");
                fileName.className = "preview-name";
                fileName.textContent = file.name;

                previewItem.appendChild(img);
                previewItem.appendChild(fileName);
                container.appendChild(previewItem);
            }
        }
        function showAnnotationFile(event) {
            const file = event.target.files[0];
            const fileName = document.getElementById("annotationFileName");
            fileName.textContent = file ? file.name : "";
        }
        async function loadDatasets() {
            try {
                const response = await fetch("/api/datasets");

                if (!response.ok) {
                throw new Error("Failed to retrieve datasets");
                }

                const datasets = await response.json();
                knownDatasetNames = datasets.map(dataset => dataset.name);
                const table = document.getElementById("datasetTable");

                if (!table) return;

                const count = document.getElementById("datasetCount");
                if (count) {
                    count.textContent = `${datasets.length} ${datasets.length === 1 ? "Dataset" : "Datasets"}`;
                }

                table.innerHTML = "";

                datasets.forEach(dataset => {
                const row = document.createElement("tr");

                row.innerHTML = `
                    <td><strong>${dataset.name}</strong></td>
                    <td>${dataset.imageCount}</td>
                    <td>${dataset.annotation || "None"}</td>
                    <td>${new Date(dataset.created).toLocaleString()}</td>
                    <td>${formatSize(dataset.size)}</td>
                    <td>
                    <button class="action-btn">View</button>
                    <button class="action-btn delete" onclick="deleteDataset('${dataset.name}')">Delete</button>
                    </td>
                `;

                table.appendChild(row);
                });
            } catch (error) {
                console.error("Dataset loading error:", error);
            }
        }

        function formatSize(bytes) {
            if (bytes === 0) return "0 MB";
            if (bytes < 1024 ** 2) return `${(bytes / 1024).toFixed(1)} KB`;
            if (bytes < 1024 ** 3) return `${(bytes / 1024 ** 2).toFixed(1)} MB`;
            return `${(bytes / 1024 ** 3).toFixed(2)} GB`;
        }
        async function deleteDataset(folderName) {
            const confirmed = confirm(`Delete dataset "${folderName}"?`);
            if (!confirmed) return;
            try {
                const response = await fetch(`/api/datasets/${encodeURIComponent(folderName)}`, {
                    method: "DELETE"
                });
                const result = await response.json();
                if (!response.ok) {
                    throw new Error(result.message || "Failed to delete dataset");
                }
                loadDatasets();
            } catch (error) {
                console.error(error);
                alert(error.message);
            }
        }
        // names already taken, refreshed by loadTrainingHistory() / loadDatasets()
        let knownRunNames = [];
        let knownDatasetNames = [];

        // must match isValidName() in utils/names.js
        const NAME_PATTERN = /^[A-Za-z0-9][A-Za-z0-9 _.-]{0,63}$/;

        // Shows the problem under a name box; returns true when the name is usable.
        function validateNameField(inputId, errorId, label, takenNames) {
            const input = document.getElementById(inputId);
            const error = document.getElementById(errorId);
            if (!input || !error) return false;

            const name = input.value.trim();
            let message = "";

            if (!name) {
                message = `Please enter a ${label.toLowerCase()}.`;
            } else if (!NAME_PATTERN.test(name) || /[ .]$/.test(name)) {
                message = "Use letters, numbers, spaces, '-', '_' or '.', starting with a letter or number.";
            } else if (takenNames.some(existing => existing.toLowerCase() === name.toLowerCase())) {
                message = `${label} "${name}" is already used. Please choose another name.`;
            }

            error.textContent = message;
            input.classList.toggle("invalid", message !== "");
            return message === "";
        }

        function validateRunName() {
            return validateNameField("runName", "runNameError", "Run name", knownRunNames);
        }

        function validateDatasetName() {
            return validateNameField("folderName", "folderNameError", "Dataset name", knownDatasetNames);
        }

        function showUploadMessage(message, type) {
            const box = document.getElementById("uploadMessage");
            if (!box) return;
            box.textContent = message;
            box.className = `upload-message ${type}`;
        }

        async function submitDataset(event) {
            event.preventDefault();
            const form = event.target;
            const nameInput = document.getElementById("folderName");
            const images = document.getElementById("images");
            const button = document.getElementById("uploadDataBtn");

            showUploadMessage("", "");
            nameInput.value = nameInput.value.trim();
            if (!validateDatasetName()) {
                nameInput.focus();
                return;
            }
            if (images.files.length === 0) {
                showUploadMessage("Please select at least one image.", "error");
                return;
            }

            const name = nameInput.value;
            button.disabled = true;
            button.textContent = "Uploading...";

            try {
                const response = await fetch("/upload", {
                    method: "POST",
                    body: new FormData(form)
                });
                const result = await response.json();

                if (response.status === 409) {
                    // name was taken since the dataset list was loaded
                    knownDatasetNames.push(name);
                    validateDatasetName();
                    return;
                }
                if (!response.ok) {
                    throw new Error(result.message || "Upload failed");
                }

                const imageCount = images.files.length;
                form.reset();
                document.getElementById("imagePreviewContainer").innerHTML = "";
                document.getElementById("imageUploadLabel").style.display = "flex";
                document.getElementById("annotationFileName").textContent = "";
                showUploadMessage(`Dataset "${name}" uploaded (${imageCount} images).`, "success");
                loadDatasets();
            } catch (error) {
                console.error("Upload error:", error);
                showUploadMessage(error.message, "error");
            } finally {
                button.disabled = false;
                button.textContent = "Upload Data";
            }
        }

        async function startTraining() {
            if (!validateRunName()) {
                document.getElementById("runName").focus();
                return;
            }
            const settings = {
                runName: document.getElementById("runName").value.trim(),
                dataset: document.getElementById("dataset").value,
                weights: document.getElementById("weights").value,
                learningRate: Number(document.getElementById("learningRate").value),
                batchSize: Number(document.getElementById("batchSize").value),
                maxIterations: Number(document.getElementById("maxIterations").value),
                advancedConfig: document.getElementById("advancedConfig").value
            };
            if (!settings.dataset) {
                alert("Please select a dataset.");
                return;
            }
            try {
                const response = await fetch("/train", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify(settings)
                });

                const result = await response.json();

                if (response.status === 409) {
                    // name was taken since the last history refresh
                    knownRunNames.push(settings.runName);
                    validateRunName();
                    return;
                }

                if (!response.ok) {
                    throw new Error(result.message || "Failed to start training");
                }

                knownRunNames.push(settings.runName);
                document.getElementById("runName").value = "";
                loadTrainingHistory();
            } catch (error) {
                console.error("Training error:", error);
                alert(error.message);
            }
        }
        async function loadTrainingHistory() {
    const table = document.getElementById("runtimeHistory");

    if (!table) return;

    try {
        const response = await fetch("/api/training");

        if (!response.ok) {
            throw new Error("Failed to retrieve training history");
        }

        const jobs = await response.json();
        knownRunNames = jobs.map(job => job.name);

        if (jobs.length === 0) {
            table.innerHTML = `
                <tr>
                    <td colspan="10">No training runs.</td>
                </tr>
            `;
            return;
        }

        table.innerHTML = "";

        jobs.forEach(job => {
            const row = document.createElement("tr");

            row.innerHTML = `
                <td></td>
                <td>${job.dataset}</td>
                <td>${job.model}</td>
                <td>${job.learningRate ?? '-'}</td>
                <td>${job.batchSize ?? '-'}</td>
                <td>${job.maxIterations?.toLocaleString() ?? '-'}</td>
                <td>
                    <span class="status ${job.status.toLowerCase()}">
                        ${job.status}
                    </span>
                </td>
                <td>${job.startTime ? formatDateTime(job.startTime) : '-'}</td>
                <td>${job.runtime == null ? '-' : formatRuntime(job.runtime)}</td>
                <td>
                    <div class="history-actions">
                        ${job.status === "Running"
                            ? `<button class="history-btn stop-training-btn" onclick="stopTraining(${job.id})">Stop</button>`
                            : ""
                        }
                    </div>
                </td>
            `;
            // the run name links to the run's YAML configuration
            const runLabel = job.name || `#${String(job.id).padStart(3, "0")}`;
            if (job.name) {
                const configLink = document.createElement('a');
                configLink.className = 'run-config-link';
                configLink.textContent = runLabel;
                configLink.href = `/api/training/${encodeURIComponent(job.name)}/config`;
                configLink.target = '_blank';
                configLink.rel = 'noopener';
                configLink.title = 'View YAML configuration';
                row.cells[0].replaceChildren(configLink);
            } else {
                row.cells[0].textContent = runLabel;
            }
            row.cells[1].textContent = job.dataset;
            if (job.status === 'Error') {
                const errorLink = document.createElement('a');
                errorLink.className = 'status error';
                errorLink.textContent = 'Error';
                errorLink.href = `/api/training/${encodeURIComponent(job.name)}/errors`;
                errorLink.target = '_blank';
                errorLink.rel = 'noopener';
                errorLink.title = 'View training errors';
                row.cells[6].replaceChildren(errorLink);
            }
            table.appendChild(row);
        });
    } catch (error) {
        console.error("Training history error:", error);
    }
}
async function stopTraining(runId) {
    const confirmed = confirm(
        `Stop training #${String(runId).padStart(3, "0")}?`
    );

    if (!confirmed) return;

    try {
        const response = await fetch(`/api/training/${runId}/stop`, {
            method: "POST"
        });

        const result = await response.json();

        if (!response.ok) {
            throw new Error(
                result.message || "Failed to stop training"
            );
        }

        loadTrainingHistory();
    } catch (error) {
        console.error("Stop training error:", error);
        alert(error.message);
    }
}

function formatRuntime(milliseconds) {
    if (!milliseconds) return "0s";

    const totalSeconds = Math.floor(milliseconds / 1000);
    const hours = Math.floor(totalSeconds / 3600);
    const minutes = Math.floor((totalSeconds % 3600) / 60);
    const seconds = totalSeconds % 60;

    if (hours > 0) {
        return `${hours}h ${minutes}m`;
    }

    if (minutes > 0) {
        return `${minutes}m ${seconds}s`;
    }

    return `${seconds}s`;
}
async function loadTrainingDatasets() {
    const datasetSelect = document.getElementById("dataset");

    if (!datasetSelect) return;

    try {
        const response = await fetch("/api/datasets");

        if (!response.ok) {
            throw new Error("Failed to retrieve datasets");
        }

        const datasets = await response.json();

        datasetSelect.innerHTML = `
            <option value="">Select dataset</option>
        `;

        datasets.forEach(dataset => {
            const option = document.createElement("option");

            option.value = dataset.name;
            option.textContent = dataset.name;

            datasetSelect.appendChild(option);
        });
    } catch (error) {
        console.error("Dataset loading error:", error);
    }
}
// ---------- Validation page ----------
let selectedValidationId = null;
let validationRunning = false;

// COCOeval.stats, in the order validate.py reports them
const VALIDATION_STATS = [
    ["AP", "AP @ IoU 0.50:0.95"],
    ["AP50", "AP @ IoU 0.50"],
    ["AP75", "AP @ IoU 0.75"],
    ["APs", "AP, small objects"],
    ["APm", "AP, medium objects"],
    ["APl", "AP, large objects"],
    ["AR1", "AR, 1 detection per image"],
    ["AR10", "AR, 10 detections per image"],
    ["AR100", "AR, 100 detections per image"],
    ["ARs", "AR, small objects"],
    ["ARm", "AR, medium objects"],
    ["ARl", "AR, large objects"]
];

// COCOeval reports -1 when there is nothing to measure (e.g. no small objects)
function formatMetric(value) {
    return value == null || value < 0 ? "n/a" : value.toFixed(3);
}

function formatDateTime(time) {
    return new Date(time).toLocaleString("en-GB", {
        timeZone: "Asia/Brunei", dateStyle: "medium", timeStyle: "short"
    }) + " (BNT)";
}

function createElement(tag, className, text) {
    const element = document.createElement(tag);
    if (className) element.className = className;
    if (text != null) element.textContent = text;
    return element;
}

async function loadValidationDatasets() {
    const select = document.getElementById("validationDataset");
    if (!select) return;

    try {
        const response = await fetch("/api/datasets");
        if (!response.ok) {
            throw new Error("Failed to retrieve datasets");
        }
        const datasets = await response.json();

        // only annotated datasets can be scored
        datasets.filter(dataset => dataset.annotation).forEach(dataset => {
            const option = createElement("option", null, `${dataset.name} (${dataset.imageCount} images)`);
            option.value = dataset.name;
            select.appendChild(option);
        });
    } catch (error) {
        console.error("Validation dataset error:", error);
    }
}

async function loadValidationImages() {
    const dataset = document.getElementById("validationDataset").value;
    const list = document.getElementById("validationImageList");
    const selectAll = document.getElementById("validationSelectAll");

    selectAll.disabled = true;
    updateValidationNotice();

    if (!dataset) {
        list.replaceChildren(createElement("p", "validation-empty", "Select a dataset to list its annotated images."));
        updateValidationSelection();
        return;
    }

    list.replaceChildren(createElement("p", "validation-empty", "Loading images..."));
    updateValidationSelection();

    try {
        const response = await fetch(`/api/datasets/${encodeURIComponent(dataset)}/images`);
        const result = await response.json();
        if (!response.ok) {
            throw new Error(result.message || "Failed to load images");
        }
        // another dataset was picked while this one loaded
        if (document.getElementById("validationDataset")?.value !== dataset) return;

        if (result.images.length === 0) {
            list.replaceChildren(createElement("p", "validation-empty", "No annotated images found in this dataset."));
        } else {
            list.replaceChildren(...result.images.map(image => {
                const label = createElement("label");
                const checkbox = createElement("input");
                checkbox.type = "checkbox";
                checkbox.value = image.fileName;
                checkbox.checked = true;
                checkbox.onchange = updateValidationSelection;
                label.append(
                    checkbox,
                    createElement("span", "image-name", image.fileName),
                    createElement("span", "image-objects", `${image.objects} objects`)
                );
                label.title = image.fileName;
                return label;
            }));
            selectAll.disabled = false;
        }
    } catch (error) {
        if (document.getElementById("validationDataset")?.value !== dataset) return;
        list.replaceChildren(createElement("p", "validation-empty error", error.message));
    }
    updateValidationSelection();
}

function selectAllValidationImages(checked) {
    document.querySelectorAll("#validationImageList input[type=checkbox]").forEach(checkbox => {
        checkbox.checked = checked;
    });
    updateValidationSelection();
}

function selectedValidationImages() {
    return [...document.querySelectorAll("#validationImageList input[type=checkbox]:checked")]
        .map(checkbox => checkbox.value);
}

function updateValidationSelection() {
    const checkboxes = document.querySelectorAll("#validationImageList input[type=checkbox]");
    const selected = selectedValidationImages().length;
    const selectAll = document.getElementById("validationSelectAll");

    document.getElementById("validationImageCount").textContent =
        checkboxes.length ? `${selected} of ${checkboxes.length} selected` : "";
    selectAll.checked = checkboxes.length > 0 && selected === checkboxes.length;
    selectAll.indeterminate = selected > 0 && selected < checkboxes.length;
    document.getElementById("runValidationBtn").disabled =
        !document.getElementById("validationModel").value || selected === 0;
}

// warn when the model is scored on the data it was trained on
function updateValidationNotice() {
    const option = document.getElementById("validationModel").selectedOptions[0];
    const dataset = document.getElementById("validationDataset").value;
    const notice = document.getElementById("validationNotice");
    const trainedOn = option?.dataset.dataset;

    notice.hidden = !(dataset && trainedOn === dataset);
    notice.textContent = `This model was trained on "${dataset}". Validating on its own training data gives optimistic results; use a separate dataset for a fair score.`;
    updateValidationSelection();
}

async function startValidation() {
    const option = document.getElementById("validationModel").selectedOptions[0];
    const dataset = document.getElementById("validationDataset").value;
    const images = selectedValidationImages();
    const button = document.getElementById("runValidationBtn");

    if (!option?.value || !dataset || images.length === 0) return;

    button.disabled = true;
    try {
        const response = await fetch("/api/validation", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                run: option.dataset.run,
                filename: option.dataset.file,
                dataset,
                images
            })
        });
        const result = await response.json();
        if (!response.ok) {
            throw new Error(result.message || "Failed to start validation");
        }
        selectedValidationId = result.id;
        await loadValidationHistory();
    } catch (error) {
        console.error("Validation error:", error);
        alert(error.message);
    } finally {
        if (document.getElementById("runValidationBtn")) updateValidationSelection();
    }
}

async function loadValidationHistory() {
    const table = document.getElementById("validationHistory");
    if (!table) return;

    try {
        const response = await fetch("/api/validation");
        if (!response.ok) {
            throw new Error("Failed to retrieve validation results");
        }
        const jobs = await response.json();
        validationRunning = jobs.some(job => job.status === "Running");

        if (jobs.length === 0) {
            table.innerHTML = `<tr><td colspan="9">No validation results.</td></tr>`;
            renderValidationDetails(null);
            return;
        }

        table.replaceChildren(...jobs.map(job => {
            const row = document.createElement("tr");
            const box = job.metrics?.results?.bbox;
            const mask = job.metrics?.results?.segm;

            row.classList.toggle("selected", job.id === selectedValidationId);
            row.innerHTML = `
                <td></td>
                <td></td>
                <td>${job.imageCount}</td>
                <td><span class="status ${job.status.toLowerCase()}"></span></td>
                <td class="metric">${box ? formatMetric(box.stats.AP50) : "-"}</td>
                <td class="metric">${mask ? formatMetric(mask.stats.AP50) : "-"}</td>
                <td class="metric">${box ? formatMetric(box.f1_50) : "-"}</td>
                <td>${formatDateTime(job.startTime)}</td>
                <td></td>
            `;
            row.cells[0].append(job.run, createElement("span", "model-file", job.filename));
            row.cells[1].textContent = job.dataset;
            row.cells[3].firstElementChild.textContent =
                job.status === "Running" && job.progress
                    ? `Running ${job.progress.done}/${job.progress.total}`
                    : job.status;

            if (["Completed", "Error"].includes(job.status)) {
                const view = createElement("button", "validation-view-btn", job.status === "Error" ? "View Error" : "View");
                view.onclick = () => {
                    selectedValidationId = job.id;
                    table.querySelectorAll("tr").forEach(other => other.classList.toggle("selected", other === row));
                    renderValidationDetails(job);
                    document.getElementById("validationDetails").scrollIntoView({ behavior: "smooth" });
                };
                row.cells[8].appendChild(view);
            }
            return row;
        }));

        renderValidationDetails(jobs.find(job => job.id === selectedValidationId) || null);
    } catch (error) {
        console.error("Validation history error:", error);
    }
}

function renderValidationDetails(job) {
    const section = document.getElementById("validationDetails");
    if (!section) return;

    if (!job || !["Completed", "Error"].includes(job.status)) {
        section.hidden = true;
        section.replaceChildren();
        return;
    }

    const header = createElement("div", "validation-section-header");
    header.appendChild(createElement("h2", null, job.status === "Error" ? "Validation Error" : "Validation Metrics"));

    const meta = createElement("div", "validation-details-meta");
    const addMeta = (label, value) => {
        const item = createElement("span", null, `${label}: `);
        item.appendChild(createElement("strong", null, value));
        meta.appendChild(item);
    };
    addMeta("Model", `${job.run} / ${job.filename}`);
    addMeta("Trained on", job.trainedOn || "Unknown");
    addMeta("Validation dataset", job.dataset);
    addMeta("Images", String(job.imageCount));
    if (job.metrics) {
        addMeta("Ground-truth objects", String(job.metrics.annotations));
        addMeta("Predictions", String(job.metrics.predictions));
        addMeta("Score threshold", String(job.metrics.scoreThreshold));
    }
    if (job.runtime != null) addMeta("Runtime", formatRuntime(job.runtime));

    section.replaceChildren(header, meta);

    if (job.status === "Error" || !job.metrics) {
        section.appendChild(createElement("pre", "validation-error", job.error || "Metrics are not available for this validation."));
        section.hidden = false;
        return;
    }

    const cards = createElement("div", "validation-metric-cards");
    [["bbox", "Bounding Box"], ["segm", "Segmentation Mask"]].forEach(([key, title]) => {
        const result = job.metrics.results[key];
        if (!result) return;

        const card = createElement("div", "validation-metric-card");
        card.appendChild(createElement("h3", null, title));

        const headline = createElement("div", "validation-headline");
        [["Precision @ 0.50", result.precision50], ["Recall @ 0.50", result.recall50], ["F1 @ 0.50", result.f1_50]]
            .forEach(([label, value]) => {
                const tile = createElement("div");
                tile.append(createElement("span", null, label), createElement("strong", null, formatMetric(value)));
                headline.appendChild(tile);
            });
        card.appendChild(headline);

        const stats = createElement("table", "validation-stats");
        VALIDATION_STATS.forEach(([name, label]) => {
            const row = stats.insertRow();
            row.insertCell().textContent = label;
            const cell = row.insertCell();
            cell.textContent = formatMetric(result.stats[name]);
            if (cell.textContent === "n/a") cell.className = "na";
        });
        card.appendChild(stats);
        cards.appendChild(card);
    });
    section.appendChild(cards);
    section.hidden = false;
}

// refresh progress while a validation is running
setInterval(() => {
    if (validationRunning && document.getElementById("validationHistory")) {
        loadValidationHistory();
    }
}, 2000);

        // Annotate is the landing page
        loadPage("annotate");
    </script>
</body>
