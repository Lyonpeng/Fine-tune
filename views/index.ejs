<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Home</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        /* IADA dashboard theme (dark gray-950 + teal), matching AcaciaGeolocation */
        :root {
            color-scheme: dark;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', 'Segoe UI', system-ui, Arial, sans-serif;
            background-color: #030712;
            color: #e5e7eb;
        }

        /* faint teal wash at the top */
        body::before {
            content: "";
            position: fixed;
            inset: 0;
            z-index: -1;
            pointer-events: none;
            background: radial-gradient(120% 90% at 50% -10%, rgba(20, 184, 166, 0.08), rgba(3, 7, 18, 0) 55%);
        }

        a {
            color: #5eead4;
        }

        /* Top bar (56px IADA bar, as in AcaciaGeolocation) */
        #hdr {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 100;

            height: 56px;
            display: flex;
            align-items: center;
            padding: 0 16px;

            background: rgba(3, 7, 18, 0.85);
            border-bottom: 1px solid rgba(31, 41, 55, 0.7);
            backdrop-filter: blur(12px);
        }

        #hdr a {
            display: flex;
            align-items: center;
        }

        #hdr img {
            height: 28px;
            width: auto;
        }

        /* Sidebar */
        .sidebar {
            position: fixed;
            top: 56px;
            left: 0;

            width: 220px;
            height: calc(100vh - 56px);

            background: rgba(3, 7, 18, 0.85);
            border-right: 1px solid rgba(31, 41, 55, 0.7);
            backdrop-filter: blur(12px);
            padding-top: 24px;
        }

        .sidebar h2 {
            color: #e5e7eb;
            font-size: 1.1rem;
            font-weight: 600;
            padding: 0 24px;
            margin-bottom: 24px;
        }

        .sidebar a {
            display: block;

            padding: 12px 24px;

            color: #9ca3af;
            text-decoration: none;
            font-size: 15px;
            border-left: 2px solid transparent;
            transition: all .15s;
        }

        .sidebar a:hover {
            background-color: rgba(31, 41, 55, 0.5);
            color: #5eead4;
        }

        /* Current page */
        .sidebar a.active {
            background-color: rgba(20, 184, 166, 0.08);
            border-left-color: #14b8a6;
            color: #5eead4;
            font-weight: 600;
        }

        /* Main content */
        .main-content {
            margin-left: 220px;
            padding: 96px 40px 40px;   /* 56px top bar + 40px */
        }

        .main-content h1 {
            margin-bottom: 10px;
            color: #e5e7eb;
        }

        .main-content p {
            color: #9ca3af;
        }
    </style>
</head>

<body>

    <!-- Top bar -->
    <div id="hdr">
        <a href="http://10.1.7.26:8083/">
            <img src="/iada-logo-onbg.png" alt="IADA">
        </a>
    </div>

    <!-- Sidebar -->
    <div class="sidebar">
        <a href="#" class="active" data-page="home" onclick="loadPage('home'); return false;">Home</a>
        <a href="#" data-page="data" onclick="loadPage('data'); return false;">Data</a>
        <a href="#" data-page="train" onclick="loadPage('train'); return false;">Train</a>
        <a href="#" data-page="model" onclick="loadPage('model'); return false;">Model</a>
    </div>
    <!-- Main page -->
    <main class="main-content">

        <h1>Home</h1>

        <p>
            Welcome to the application.
            Use the sidebar to navigate between the different sections.
        </p>

    </main>
    <script>

        async function loadPage(page) {
            // highlight the sidebar link of the page being shown
            document.querySelectorAll(".sidebar a").forEach(link => {
                link.classList.toggle("active", link.dataset.page === page);
            });

            const response = await fetch(`/pages/${page}`);
            const html = await response.text();

            document.querySelector(".main-content").innerHTML = html;

            if (page === "data") {
                loadDatasets();
            }

            if (page === "train") {
                loadTrainingDatasets();
                loadTrainingHistory();
            }
        }
        setInterval(() => {
            if (document.getElementById("runtimeHistory")) {
                loadTrainingHistory();
            }
        }, 1000);
        function previewImages(event) {
            const files = event.target.files;
            const container = document.getElementById("imagePreviewContainer");
            const uploadLabel = document.getElementById("imageUploadLabel");

            container.innerHTML = "";

            if (files.length === 0) {
                uploadLabel.style.display = "flex";
                return;
            }

            uploadLabel.style.display = "none";

            for (const file of files) {
                const previewItem = document.createElement("div");
                previewItem.className = "preview-item";

                const img = document.createElement("img");
                img.src = URL.createObjectURL(file);

                const fileName = document.createElement("div");
                fileName.className = "preview-name";
                fileName.textContent = file.name;

                previewItem.appendChild(img);
                previewItem.appendChild(fileName);
                container.appendChild(previewItem);
            }
        }
        function showAnnotationFile(event) {
            const file = event.target.files[0];
            const fileName = document.getElementById("annotationFileName");
            fileName.textContent = file ? file.name : "";
        }
        async function loadDatasets() {
            try {
                const response = await fetch("/api/datasets");

                if (!response.ok) {
                throw new Error("Failed to retrieve datasets");
                }

                const datasets = await response.json();
                knownDatasetNames = datasets.map(dataset => dataset.name);
                const table = document.getElementById("datasetTable");

                if (!table) return;

                const count = document.getElementById("datasetCount");
                if (count) {
                    count.textContent = `${datasets.length} ${datasets.length === 1 ? "Dataset" : "Datasets"}`;
                }

                table.innerHTML = "";

                datasets.forEach(dataset => {
                const row = document.createElement("tr");

                row.innerHTML = `
                    <td><strong>${dataset.name}</strong></td>
                    <td>${dataset.imageCount}</td>
                    <td>${dataset.annotation || "None"}</td>
                    <td>${new Date(dataset.created).toLocaleString()}</td>
                    <td>${formatSize(dataset.size)}</td>
                    <td>
                    <button class="action-btn">View</button>
                    <button class="action-btn delete" onclick="deleteDataset('${dataset.name}')">Delete</button>
                    </td>
                `;

                table.appendChild(row);
                });
            } catch (error) {
                console.error("Dataset loading error:", error);
            }
        }

        function formatSize(bytes) {
            if (bytes === 0) return "0 MB";
            if (bytes < 1024 ** 2) return `${(bytes / 1024).toFixed(1)} KB`;
            if (bytes < 1024 ** 3) return `${(bytes / 1024 ** 2).toFixed(1)} MB`;
            return `${(bytes / 1024 ** 3).toFixed(2)} GB`;
        }
        async function deleteDataset(folderName) {
            const confirmed = confirm(`Delete dataset "${folderName}"?`);
            if (!confirmed) return;
            try {
                const response = await fetch(`/api/datasets/${encodeURIComponent(folderName)}`, {
                    method: "DELETE"
                });
                const result = await response.json();
                if (!response.ok) {
                    throw new Error(result.message || "Failed to delete dataset");
                }
                loadDatasets();
            } catch (error) {
                console.error(error);
                alert(error.message);
            }
        }
        // names already taken, refreshed by loadTrainingHistory() / loadDatasets()
        let knownRunNames = [];
        let knownDatasetNames = [];

        // must match isValidName() in utils/names.js
        const NAME_PATTERN = /^[A-Za-z0-9][A-Za-z0-9 _.-]{0,63}$/;

        // Shows the problem under a name box; returns true when the name is usable.
        function validateNameField(inputId, errorId, label, takenNames) {
            const input = document.getElementById(inputId);
            const error = document.getElementById(errorId);
            if (!input || !error) return false;

            const name = input.value.trim();
            let message = "";

            if (!name) {
                message = `Please enter a ${label.toLowerCase()}.`;
            } else if (!NAME_PATTERN.test(name) || /[ .]$/.test(name)) {
                message = "Use letters, numbers, spaces, '-', '_' or '.', starting with a letter or number.";
            } else if (takenNames.some(existing => existing.toLowerCase() === name.toLowerCase())) {
                message = `${label} "${name}" is already used. Please choose another name.`;
            }

            error.textContent = message;
            input.classList.toggle("invalid", message !== "");
            return message === "";
        }

        function validateRunName() {
            return validateNameField("runName", "runNameError", "Run name", knownRunNames);
        }

        function validateDatasetName() {
            return validateNameField("folderName", "folderNameError", "Dataset name", knownDatasetNames);
        }

        function showUploadMessage(message, type) {
            const box = document.getElementById("uploadMessage");
            if (!box) return;
            box.textContent = message;
            box.className = `upload-message ${type}`;
        }

        async function submitDataset(event) {
            event.preventDefault();
            const form = event.target;
            const nameInput = document.getElementById("folderName");
            const images = document.getElementById("images");
            const button = document.getElementById("uploadDataBtn");

            showUploadMessage("", "");
            nameInput.value = nameInput.value.trim();
            if (!validateDatasetName()) {
                nameInput.focus();
                return;
            }
            if (images.files.length === 0) {
                showUploadMessage("Please select at least one image.", "error");
                return;
            }

            const name = nameInput.value;
            button.disabled = true;
            button.textContent = "Uploading...";

            try {
                const response = await fetch("/upload", {
                    method: "POST",
                    body: new FormData(form)
                });
                const result = await response.json();

                if (response.status === 409) {
                    // name was taken since the dataset list was loaded
                    knownDatasetNames.push(name);
                    validateDatasetName();
                    return;
                }
                if (!response.ok) {
                    throw new Error(result.message || "Upload failed");
                }

                const imageCount = images.files.length;
                form.reset();
                document.getElementById("imagePreviewContainer").innerHTML = "";
                document.getElementById("imageUploadLabel").style.display = "flex";
                document.getElementById("annotationFileName").textContent = "";
                showUploadMessage(`Dataset "${name}" uploaded (${imageCount} images).`, "success");
                loadDatasets();
            } catch (error) {
                console.error("Upload error:", error);
                showUploadMessage(error.message, "error");
            } finally {
                button.disabled = false;
                button.textContent = "Upload Data";
            }
        }

        async function startTraining() {
            if (!validateRunName()) {
                document.getElementById("runName").focus();
                return;
            }
            const settings = {
                runName: document.getElementById("runName").value.trim(),
                dataset: document.getElementById("dataset").value,
                weights: document.getElementById("weights").value,
                learningRate: Number(document.getElementById("learningRate").value),
                batchSize: Number(document.getElementById("batchSize").value),
                maxIterations: Number(document.getElementById("maxIterations").value),
                advancedConfig: document.getElementById("advancedConfig").value
            };
            if (!settings.dataset) {
                alert("Please select a dataset.");
                return;
            }
            try {
                const response = await fetch("/train", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify(settings)
                });

                const result = await response.json();

                if (response.status === 409) {
                    // name was taken since the last history refresh
                    knownRunNames.push(settings.runName);
                    validateRunName();
                    return;
                }

                if (!response.ok) {
                    throw new Error(result.message || "Failed to start training");
                }

                knownRunNames.push(settings.runName);
                document.getElementById("runName").value = "";
                loadTrainingHistory();
            } catch (error) {
                console.error("Training error:", error);
                alert(error.message);
            }
        }
        async function loadTrainingHistory() {
    const table = document.getElementById("runtimeHistory");

    if (!table) return;

    try {
        const response = await fetch("/api/training");

        if (!response.ok) {
            throw new Error("Failed to retrieve training history");
        }

        const jobs = await response.json();
        knownRunNames = jobs.map(job => job.name);

        if (jobs.length === 0) {
            table.innerHTML = `
                <tr>
                    <td colspan="9">No training runs.</td>
                </tr>
            `;
            return;
        }

        table.innerHTML = "";

        jobs.forEach(job => {
            const row = document.createElement("tr");

            row.innerHTML = `
                <td></td>
                <td>${job.dataset}</td>
                <td>${job.model}</td>
                <td>${job.learningRate ?? '-'}</td>
                <td>${job.batchSize ?? '-'}</td>
                <td>${job.maxIterations?.toLocaleString() ?? '-'}</td>
                <td>
                    <span class="status ${job.status.toLowerCase()}">
                        ${job.status}
                    </span>
                </td>
                <td>${job.runtime == null ? '-' : formatRuntime(job.runtime)}</td>
                <td>
                    <div class="history-actions">
                        ${job.status === "Running"
                            ? `<button class="history-btn stop-training-btn" onclick="stopTraining(${job.id})">Stop</button>`
                            : ""
                        }
                    </div>
                </td>
            `;
            row.cells[0].textContent = job.name || `#${String(job.id).padStart(3, "0")}`;
            row.cells[1].textContent = job.dataset;
            if (job.status === 'Error') {
                const errorLink = document.createElement('a');
                errorLink.className = 'status error';
                errorLink.textContent = 'Error';
                errorLink.href = `/api/training/${encodeURIComponent(job.name)}/errors`;
                errorLink.target = '_blank';
                errorLink.rel = 'noopener';
                errorLink.title = 'View training errors';
                row.cells[6].replaceChildren(errorLink);
            }
            const view = document.createElement('a');
            view.textContent = 'View';
            view.href = `/api/training/${encodeURIComponent(job.name)}/config`;
            view.target = '_blank';
            view.rel = 'noopener';
            view.style.marginLeft = '8px';
            row.cells[8].appendChild(view);
            table.appendChild(row);
        });
    } catch (error) {
        console.error("Training history error:", error);
    }
}
async function stopTraining(runId) {
    const confirmed = confirm(
        `Stop training #${String(runId).padStart(3, "0")}?`
    );

    if (!confirmed) return;

    try {
        const response = await fetch(`/api/training/${runId}/stop`, {
            method: "POST"
        });

        const result = await response.json();

        if (!response.ok) {
            throw new Error(
                result.message || "Failed to stop training"
            );
        }

        loadTrainingHistory();
    } catch (error) {
        console.error("Stop training error:", error);
        alert(error.message);
    }
}

function formatRuntime(milliseconds) {
    if (!milliseconds) return "0s";

    const totalSeconds = Math.floor(milliseconds / 1000);
    const hours = Math.floor(totalSeconds / 3600);
    const minutes = Math.floor((totalSeconds % 3600) / 60);
    const seconds = totalSeconds % 60;

    if (hours > 0) {
        return `${hours}h ${minutes}m`;
    }

    if (minutes > 0) {
        return `${minutes}m ${seconds}s`;
    }

    return `${seconds}s`;
}
async function loadTrainingDatasets() {
    const datasetSelect = document.getElementById("dataset");

    if (!datasetSelect) return;

    try {
        const response = await fetch("/api/datasets");

        if (!response.ok) {
            throw new Error("Failed to retrieve datasets");
        }

        const datasets = await response.json();

        datasetSelect.innerHTML = `
            <option value="">Select dataset</option>
        `;

        datasets.forEach(dataset => {
            const option = document.createElement("option");

            option.value = dataset.name;
            option.textContent = dataset.name;

            datasetSelect.appendChild(option);
        });
    } catch (error) {
        console.error("Dataset loading error:", error);
    }
}
    </script>
</body>
</html>
