<div class="train-page">

    <!-- Training Configuration -->
    <section class="train-section">
        <div class="section-header">
            <h2>Training Configuration</h2>
        </div>

        <div class="config-grid">

            <div class="form-group full-width">
                <label for="runName">Run Name</label>
                <input
                    type="text"
                    id="runName"
                    name="runName"
                    placeholder="e.g. acacia_maskrcnn_v1"
                    maxlength="64"
                    autocomplete="off"
                    oninput="validateRunName()"
                >
                <span id="runNameError" class="field-error"></span>
            </div>

            <div class="form-group">
                <label for="model">Model</label>
                <select id="model" name="model">
                    <option value="maskrcnn">Mask R-CNN</option>
                </select>
            </div>
            <div class="form-group">
                <label for="dataset">Dataset</label>
                <select id="dataset" name="dataset">
                    <option value="">Select dataset</option>
                </select>
            </div>

            <div class="form-group">
                <label for="weights">Transfer learning</label>
                <select id="weights" name="weights">
                    <option value="apply">Yes</option>
                    <option value="none">No (From Scratch)</option>
                </select>
            </div>

            <div class="form-group">
                <label for="learningRate">Learning Rate</label>
                <input
                    type="number"
                    id="learningRate"
                    name="learningRate"
                    value="0.001"
                    step="0.0001"
                >
            </div>

            <div class="form-group">
                <label for="batchSize">Batch Size</label>
                <input
                    type="number"
                    id="batchSize"
                    name="batchSize"
                    value="5"
                    min="1"
                >
            </div>

            <div class="form-group">
                <label for="maxIterations">Maximum Iterations</label>
                <input
                    type="number"
                    id="maxIterations"
                    name="maxIterations"
                    value="20000"
                    min="1"
                >
            </div>


        </div>
        <details class="advanced-config">
            <summary>Advanced Configuration</summary>
            <div class="advanced-content">
                <textarea
                    id="advancedConfig"
                    class="config-editor"
                    placeholder="SOLVER.MOMENTUM 0.9&#10;SOLVER.WEIGHT_DECAY 0.0005&#10;SOLVER.WARMUP_ITERS 1000&#10;DATALOADER.NUM_WORKERS 4"
                ></textarea>
            </div>
        </details>
        <div class="train-actions">
            <button class="run-training-btn" onclick="startTraining()">
                Run Training
            </button>
        </div>
    </section>


    <!-- Runtime History -->
    <section class="train-section">
        <div class="section-header">
            <h2>Runtime History</h2>
        </div>

        <div class="table-container">
            <table class="runtime-table">
                <thead>
                    <tr>
                        <th>Run</th>
                        <th>Dataset</th>
                        <th>Model</th>
                        <th>Learning Rate</th>
                        <th>Batch Size</th>
                        <th>Iterations</th>
                        <th>Status</th>
                        <th>Runtime</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody id="runtimeHistory">
                    <tr>
                        <td colspan="9">Loading training runs...</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

</div>


<style>
    .train-page {
        max-width: 1200px;
    }


    /* Sections */

    .train-section {
        background: rgba(17, 24, 39, 0.55);
        border: 1px solid rgba(31, 41, 55, 0.7);
        border-radius: 12px;
        padding: 25px;
        margin-bottom: 25px;
    }

    .section-header {
        margin-bottom: 25px;
    }

    .section-header h2 {
        font-size: 20px;
        color: #e5e7eb;
        margin-bottom: 6px;
    }

    .section-header p {
        color: #9ca3af;
        font-size: 14px;
    }


    /* Configuration */

    .config-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .form-group label {
        font-size: .8rem;
        font-weight: 600;
        letter-spacing: .05em;
        color: #e5e7eb;
        margin-bottom: 6px;
    }

    .form-group input,
    .form-group select {
        padding: 10px 12px;

        border: 1px solid #374151;
        border-radius: 6px;

        font-size: 14px;
        font-family: inherit;
        background: rgba(3, 7, 18, 0.5);
        color: #e5e7eb;
    }

    .form-group select option {
        background-color: #111827;
        color: #e5e7eb;
    }

    .form-group input:focus,
    .form-group select:focus {
        outline: none;
        border-color: #14b8a6;
    }

    .form-group.full-width {
        grid-column: 1 / -1;
    }

    .form-group input.invalid {
        border-color: rgba(248, 113, 113, 0.6);
    }

    .field-error {
        display: none;
        margin-top: 6px;
        color: #f87171;
        font-size: 13px;
    }

    .field-error:not(:empty) {
        display: block;
    }


    /* Run training button */

    .train-actions {
        display: flex;
        justify-content: flex-end;
        margin-top: 25px;
    }

    .run-training-btn {
        background: linear-gradient(to top, #0d9488, #14b8a6);
        color: #fff;

        border: none;
        border-radius: 6px;

        padding: 10px 24px;

        font-size: 14px;
        font-weight: 600;
        font-family: inherit;

        cursor: pointer;
    }

    .run-training-btn:hover {
        background: linear-gradient(to top, #0f766e, #0d9488);
    }


    /* Runtime history */

    .table-container {
        overflow-x: auto;
    }

    .runtime-table {
        width: 100%;
        border-collapse: collapse;
    }

    .runtime-table th,
    .runtime-table td {
        padding: 12px 10px;
        text-align: left;
        border-bottom: 1px solid rgba(31, 41, 55, 0.5);
        font-size: 14px;
    }

    .runtime-table th {
        font-size: .72rem;
        text-transform: uppercase;
        letter-spacing: .05em;
        color: #9ca3af;
        border-bottom-color: #1f2937;
        font-weight: 600;
        vertical-align: bottom;
    }

    .runtime-table td {
        color: #d1d5db;
    }

    .runtime-table td a {
        color: #5eead4;
        text-decoration: none;
    }

    .runtime-table td a:hover {
        text-decoration: underline;
    }


    /* Status */

    .status {
        display: inline-block;
        padding: 4px 10px;
        border: 1px solid transparent;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .status.completed {
        background-color: rgba(22, 101, 52, 0.2);
        border-color: rgba(74, 222, 128, 0.4);
        color: #4ade80;
    }

    .status.running {
        background-color: rgba(20, 184, 166, 0.12);
        border-color: rgba(20, 184, 166, 0.45);
        color: #5eead4;
    }

    .status.failed,
    .status.error {
        background-color: rgba(127, 29, 29, 0.25);
        border-color: rgba(248, 113, 113, 0.4);
        color: #f87171;
    }
    .advanced-config {
        margin-top: 25px;
        border-top: 1px solid rgba(31, 41, 55, 0.7);
        padding-top: 20px;
    }

    .advanced-config summary {
        font-size: 15px;
        font-weight: 600;
        color: #d1d5db;
        cursor: pointer;
    }

    .advanced-config summary:hover,
    .advanced-config[open] summary {
        color: #5eead4;
    }

    .advanced-content {
        margin-top: 20px;
    }

    .advanced-content p {
        font-size: 13px;
        color: #9ca3af;
        margin-bottom: 10px;
    }

    .config-editor {
        width: 100%;
        min-height: 220px;
        padding: 15px;
        border: 1px solid #374151;
        border-radius: 6px;
        background: rgba(3, 7, 18, 0.5);
        color: #e5e7eb;
        font-family: monospace;
        font-size: 13px;
        line-height: 1.5;
        resize: vertical;
    }

    .config-editor::placeholder {
        color: #6b7280;
    }

    .config-editor:focus {
        outline: none;
        border-color: #14b8a6;
    }

    /* Smaller screens */

    @media (max-width: 800px) {
        .config-grid {
            grid-template-columns: 1fr;
        }
    }
    /* long run names wrap so the Action column stays inside the card */
    .runtime-table td:first-child {
        min-width: 140px;
        overflow-wrap: anywhere;
    }

    .runtime-table td:nth-child(3),
    .runtime-table td:last-child {
        white-space: nowrap;
    }

    /* View + Stop: same button, side by side (like View/Delete on the Data page) */
    .history-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .runtime-table .history-btn {
        display: inline-block;
        padding: 4px 12px;
        border: 1px solid #374151;
        border-radius: 6px;
        background-color: #111827;
        color: #d1d5db;
        font-size: 13px;
        font-family: inherit;
        line-height: normal;
        text-decoration: none;
        white-space: nowrap;
        cursor: pointer;
        transition: all .15s;
    }

    .runtime-table .history-btn:hover {
        border-color: rgba(20, 184, 166, 0.45);
        color: #5eead4;
        text-decoration: none;
    }

    .runtime-table .stop-training-btn {
        color: #f87171;
    }

    .runtime-table .stop-training-btn:hover {
        background-color: rgba(248, 113, 113, 0.12);
        border-color: rgba(248, 113, 113, 0.45);
        color: #f87171;
    }

    .status.stopping {
        background-color: rgba(120, 53, 15, 0.25);
        border-color: rgba(251, 191, 36, 0.4);
        color: #fbbf24;
    }

    .status.error {
        background-color: rgba(127, 29, 29, 0.25);
        border-color: rgba(248, 113, 113, 0.4);
        color: #f87171;
    }


    .status.stopped {
        background-color: rgba(31, 41, 55, 0.6);
        border-color: #374151;
        color: #9ca3af;
    }
</style>
