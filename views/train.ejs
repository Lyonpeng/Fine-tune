<div class="train-page">

    <!-- Training Configuration -->
    <section class="train-section">
        <div class="section-header">
            <h2>Training Configuration</h2>
        </div>

        <div class="config-grid">

            <div class="form-group">
                <label for="model">Model</label>
                <select id="model" name="model">
                    <option value="maskrcnn">Mask R-CNN</option>
                </select>
            </div>
            <div class="form-group">
                <label for="dataset">Dataset</label>
                <select id="dataset" name="dataset">
                    <option value="">Select dataset</option>
                </select>
            </div>

            <div class="form-group">
                <label for="weights">Transfer learning</label>
                <select id="weights" name="weights">
                    <option value="apply">Yes</option>
                    <option value="none">No (From Scratch)</option>
                </select>
            </div>

            <div class="form-group">
                <label for="learningRate">Learning Rate</label>
                <input
                    type="number"
                    id="learningRate"
                    name="learningRate"
                    value="0.001"
                    step="0.0001"
                >
            </div>

            <div class="form-group">
                <label for="batchSize">Batch Size</label>
                <input
                    type="number"
                    id="batchSize"
                    name="batchSize"
                    value="5"
                    min="1"
                >
            </div>

            <div class="form-group">
                <label for="maxIterations">Maximum Iterations</label>
                <input
                    type="number"
                    id="maxIterations"
                    name="maxIterations"
                    value="20000"
                    min="1"
                >
            </div>


        </div>
        <details class="advanced-config">
            <summary>Advanced Configuration</summary>
            <div class="advanced-content">
                <textarea
                    id="advancedConfig"
                    class="config-editor"
                    placeholder="SOLVER.MOMENTUM 0.9&#10;SOLVER.WEIGHT_DECAY 0.0005&#10;SOLVER.WARMUP_ITERS 1000&#10;DATALOADER.NUM_WORKERS 4"
                ></textarea>
            </div>
        </details>
        <div class="train-actions">
            <button class="run-training-btn" onclick="startTraining()">
                Run Training
            </button>
        </div>
    </section>


    <!-- Runtime History -->
    <section class="train-section">
        <div class="section-header">
            <h2>Runtime History</h2>
        </div>

        <div class="table-container">
            <table class="runtime-table">
                <thead>
                    <tr>
                        <th>Run</th>
                        <th>Dataset</th>
                        <th>Model</th>
                        <th>Learning Rate</th>
                        <th>Batch Size</th>
                        <th>Iterations</th>
                        <th>Status</th>
                        <th>Runtime</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody id="runtimeHistory">
                    <tr>
                        <td colspan="9">Loading training runs...</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

</div>


<style>
    .train-page {
        max-width: 1200px;
    }


    /* Sections */

    .train-section {
        background-color: white;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 25px;
        margin-bottom: 25px;
    }

    .section-header {
        margin-bottom: 25px;
    }

    .section-header h2 {
        font-size: 20px;
        color: #111827;
        margin-bottom: 6px;
    }

    .section-header p {
        color: #6b7280;
        font-size: 14px;
    }


    /* Configuration */

    .config-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .form-group label {
        font-size: 14px;
        font-weight: 600;
        color: #374151;
        margin-bottom: 8px;
    }

    .form-group input,
    .form-group select {
        padding: 10px 12px;

        border: 1px solid #d1d5db;
        border-radius: 5px;

        font-size: 14px;
        background-color: white;
    }

    .form-group input:focus,
    .form-group select:focus {
        outline: none;
        border-color: #4b5563;
    }


    /* Run training button */

    .train-actions {
        display: flex;
        justify-content: flex-end;
        margin-top: 25px;
    }

    .run-training-btn {
        background-color: #1f2937;
        color: white;

        border: none;
        border-radius: 5px;

        padding: 11px 22px;

        font-size: 14px;
        font-weight: 600;

        cursor: pointer;
    }

    .run-training-btn:hover {
        background-color: #374151;
    }


    /* Runtime history */

    .table-container {
        overflow-x: auto;
    }

    .runtime-table {
        width: 100%;
        border-collapse: collapse;
    }

    .runtime-table th,
    .runtime-table td {
        padding: 12px 15px;
        text-align: left;
        border-bottom: 1px solid #e5e7eb;
        font-size: 14px;
    }

    .runtime-table th {
        color: #374151;
        background-color: #f9fafb;
        font-weight: 600;
    }

    .runtime-table td {
        color: #4b5563;
    }


    /* Status */

    .status {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .status.completed {
        background-color: #dcfce7;
        color: #166534;
    }

    .status.running {
        background-color: #dbeafe;
        color: #1d4ed8;
    }

    .status.failed,
    .status.error {
        background-color: #fee2e2;
        color: #991b1b;
    }
    .advanced-config {
        margin-top: 25px;
        border-top: 1px solid #e5e7eb;
        padding-top: 20px;
    }

    .advanced-config summary {
        font-size: 15px;
        font-weight: 600;
        color: #374151;
        cursor: pointer;
    }

    .advanced-content {
        margin-top: 20px;
    }

    .advanced-content p {
        font-size: 13px;
        color: #6b7280;
        margin-bottom: 10px;
    }

    .config-editor {
        width: 100%;
        min-height: 220px;
        padding: 15px;
        border: 1px solid #d1d5db;
        border-radius: 5px;
        font-family: monospace;
        font-size: 13px;
        line-height: 1.5;
        resize: vertical;
    }

    .config-editor:focus {
        outline: none;
        border-color: #4b5563;
    }

    /* Smaller screens */

    @media (max-width: 800px) {
        .config-grid {
            grid-template-columns: 1fr;
        }
    }
    .stop-training-btn {
        padding: 6px 12px;
        border: none;
        border-radius: 5px;
        background-color: #dc2626;
        color: white;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
    }

    .stop-training-btn:hover {
        background-color: #b91c1c;
    }

    .status.stopping {
        background-color: #fef3c7;
        color: #92400e;
    }

    .status.error {
        background-color: #fee2e2;
        color: #991b1b;
    }


    .status.stopped {
        background-color: #f3f4f6;
        color: #4b5563;
    }
</style>
