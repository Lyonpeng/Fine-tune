<div class="validation-page">

    <!-- Validation setup -->
    <section class="validation-section">
        <div class="validation-section-header">
            <h2>Model Validation</h2>
        </div>

        <div class="validation-grid">
            <div class="validation-field">
                <label for="validationModel">Model</label>
                <select id="validationModel" onchange="updateValidationNotice()">
                    <option value="">Select model</option>
                    <% models.forEach(model => { %>
                        <option
                            value="<%= model.name %>/<%= model.filename %>"
                            data-run="<%= model.name %>"
                            data-file="<%= model.filename %>"
                            data-dataset="<%= model.dataset %>"
                            <%= model.hasConfig ? '' : 'disabled' %>
                        ><%= model.name %> — <%= model.filename %><%= model.hasConfig ? '' : ' (no config.yaml)' %></option>
                    <% }); %>
                </select>
                <% if (models.length === 0) { %>
                    <span class="validation-hint">No trained models available. Train a model first.</span>
                <% } %>
            </div>

            <div class="validation-field">
                <label for="validationDataset">Validation Dataset</label>
                <select id="validationDataset" onchange="loadValidationImages()">
                    <option value="">Select dataset</option>
                </select>
            </div>
        </div>

        <p id="validationNotice" class="validation-notice" hidden></p>

        <div class="validation-images">
            <div class="validation-images-header">
                <span class="validation-images-title">Validation Images</span>
                <label class="validation-select-all">
                    <input type="checkbox" id="validationSelectAll" onchange="selectAllValidationImages(this.checked)" disabled>
                    Select all
                </label>
                <span id="validationImageCount" class="validation-image-count"></span>
            </div>
            <div id="validationImageList" class="validation-image-list">
                <p class="validation-empty">Select a dataset to list its annotated images.</p>
            </div>
        </div>

        <div class="validation-actions">
            <button id="runValidationBtn" class="run-validation-btn" onclick="startValidation()" disabled>
                Run Validation
            </button>
        </div>
    </section>

    <!-- Validation results -->
    <section class="validation-section">
        <div class="validation-section-header">
            <h2>Validation Results</h2>
        </div>

        <div class="validation-table-container">
            <table class="validation-table">
                <thead>
                    <tr>
                        <th>Model</th>
                        <th>Dataset</th>
                        <th>Images</th>
                        <th>Status</th>
                        <th>Box AP50</th>
                        <th>Mask AP50</th>
                        <th>Box F1</th>
                        <th>Started</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody id="validationHistory">
                    <tr><td colspan="9">Loading validation results...</td></tr>
                </tbody>
            </table>
        </div>
    </section>

    <!-- Metrics of the selected result -->
    <section id="validationDetails" class="validation-section" hidden></section>
</div>

<style>
    .validation-page { max-width: 1200px; }
    .validation-section { background: rgba(17, 24, 39, 0.55); border: 1px solid rgba(31, 41, 55, 0.7); border-radius: 12px; padding: 25px; margin-bottom: 25px; }
    .validation-section[hidden] { display: none; }
    .validation-section-header { margin-bottom: 25px; }
    .validation-section-header h2 { font-size: 20px; color: #e5e7eb; margin-bottom: 6px; }

    /* Setup form */
    .validation-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
    .validation-field { display: flex; flex-direction: column; min-width: 0; }
    .validation-field label, .validation-images-title { font-size: .8rem; font-weight: 600; letter-spacing: .05em; color: #e5e7eb; margin-bottom: 6px; }
    .validation-field select { padding: 10px 12px; border: 1px solid #374151; border-radius: 6px; font-size: 14px; font-family: inherit; background: rgba(3, 7, 18, 0.5); color: #e5e7eb; text-overflow: ellipsis; }
    .validation-field select option { background-color: #111827; color: #e5e7eb; }
    .validation-field select:focus { outline: none; border-color: #14b8a6; }
    .validation-hint { margin-top: 6px; color: #9ca3af; font-size: 13px; }
    .validation-notice { margin-top: 16px; padding: 10px 12px; border: 1px solid rgba(251, 191, 36, 0.4); border-radius: 6px; background: rgba(120, 53, 15, 0.25); color: #fbbf24; font-size: 13px; }
    .validation-notice[hidden] { display: none; }

    /* Image checklist */
    .validation-images { margin-top: 25px; }
    .validation-images-header { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; margin-bottom: 8px; }
    .validation-images-title { margin-bottom: 0; }
    .validation-select-all { display: inline-flex; align-items: center; gap: 6px; color: #d1d5db; font-size: 13px; cursor: pointer; }
    .validation-image-count { margin-left: auto; color: #9ca3af; font-size: 13px; }
    .validation-image-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 4px 12px; max-height: 260px; overflow-y: auto; padding: 12px; border: 1px solid #374151; border-radius: 6px; background: rgba(3, 7, 18, 0.5); }
    .validation-image-list label { display: flex; align-items: center; gap: 8px; padding: 4px 6px; border-radius: 4px; color: #d1d5db; font-size: 13px; cursor: pointer; min-width: 0; }
    .validation-image-list label:hover { background: rgba(31, 41, 55, 0.5); }
    .validation-image-list .image-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .validation-image-list .image-objects { margin-left: auto; color: #6b7280; font-size: 12px; white-space: nowrap; }
    .validation-images input[type="checkbox"] { accent-color: #14b8a6; }
    .validation-empty { grid-column: 1 / -1; color: #9ca3af; font-size: 13px; }
    .validation-empty.error { color: #f87171; }

    .validation-actions { display: flex; justify-content: flex-end; margin-top: 25px; }
    .run-validation-btn { background: linear-gradient(to top, #0d9488, #14b8a6); color: #fff; border: none; border-radius: 6px; padding: 10px 24px; font-size: 14px; font-weight: 600; font-family: inherit; cursor: pointer; }
    .run-validation-btn:hover { background: linear-gradient(to top, #0f766e, #0d9488); }
    .run-validation-btn:disabled { background: #374151; color: #9ca3af; cursor: not-allowed; }

    /* Results table */
    .validation-table-container { overflow-x: auto; }
    .validation-table { width: 100%; border-collapse: collapse; }
    .validation-table th, .validation-table td { padding: 12px 10px; text-align: left; border-bottom: 1px solid rgba(31, 41, 55, 0.5); font-size: 14px; }
    .validation-table th { font-size: .72rem; text-transform: uppercase; letter-spacing: .05em; color: #9ca3af; border-bottom-color: #1f2937; font-weight: 600; vertical-align: bottom; white-space: nowrap; }
    .validation-table td { color: #d1d5db; }
    .validation-table td:first-child { min-width: 160px; overflow-wrap: anywhere; }
    .validation-table td.metric { font-variant-numeric: tabular-nums; white-space: nowrap; }
    .validation-table td:nth-child(8), .validation-table td:last-child { white-space: nowrap; }
    .validation-table .model-file { display: block; color: #6b7280; font-size: 12px; }
    .validation-table tr.selected td { background: rgba(20, 184, 166, 0.06); }
    .validation-view-btn { padding: 4px 12px; border: 1px solid #374151; border-radius: 6px; background: #111827; color: #d1d5db; font-size: 13px; font-family: inherit; cursor: pointer; transition: all .15s; }
    .validation-view-btn:hover { border-color: rgba(20, 184, 166, 0.45); color: #5eead4; }
    .validation-view-btn:focus-visible { outline: 2px solid #14b8a6; outline-offset: 2px; }

    .validation-page .status { display: inline-block; padding: 4px 10px; border: 1px solid transparent; border-radius: 20px; font-size: 12px; font-weight: 600; white-space: nowrap; }
    .validation-page .status.completed { background-color: rgba(22, 101, 52, 0.2); border-color: rgba(74, 222, 128, 0.4); color: #4ade80; }
    .validation-page .status.running { background-color: rgba(20, 184, 166, 0.12); border-color: rgba(20, 184, 166, 0.45); color: #5eead4; }
    .validation-page .status.error { background-color: rgba(127, 29, 29, 0.25); border-color: rgba(248, 113, 113, 0.4); color: #f87171; }
    .validation-page .status.unknown { background-color: rgba(31, 41, 55, 0.6); border-color: #374151; color: #9ca3af; }

    /* Metric details */
    .validation-details-meta { display: flex; flex-wrap: wrap; gap: 8px 24px; margin-bottom: 20px; color: #9ca3af; font-size: 13px; }
    .validation-details-meta strong { color: #e5e7eb; font-weight: 600; }
    .validation-metric-cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
    .validation-metric-card { border: 1px solid #1f2937; border-radius: 10px; padding: 20px; background: rgba(3, 7, 18, 0.35); min-width: 0; }
    .validation-metric-card h3 { font-size: 15px; color: #e5e7eb; margin-bottom: 16px; }
    .validation-headline { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 18px; }
    .validation-headline div { padding: 12px; border: 1px solid #1f2937; border-radius: 8px; background: rgba(17, 24, 39, 0.6); }
    .validation-headline span { display: block; color: #9ca3af; font-size: 12px; margin-bottom: 4px; }
    .validation-headline strong { color: #5eead4; font-size: 22px; font-weight: 600; font-variant-numeric: tabular-nums; }
    .validation-stats { width: 100%; border-collapse: collapse; }
    .validation-stats td { padding: 6px 0; border-bottom: 1px solid rgba(31, 41, 55, 0.5); color: #d1d5db; font-size: 13px; }
    .validation-stats td:last-child { text-align: right; font-variant-numeric: tabular-nums; color: #e5e7eb; }
    .validation-stats td.na { color: #6b7280; }
    .validation-error { margin: 0; padding: 15px; max-height: 320px; overflow: auto; border: 1px solid rgba(248, 113, 113, 0.4); border-radius: 6px; background: rgba(3, 7, 18, 0.5); color: #fca5a5; font-family: monospace; font-size: 12px; white-space: pre-wrap; }

    @media (max-width: 900px) {
        .validation-grid, .validation-metric-cards { grid-template-columns: 1fr; }
    }
    @media (max-width: 600px) {
        .validation-section { padding: 15px; }
        .validation-headline { grid-template-columns: 1fr; }
    }
</style>
